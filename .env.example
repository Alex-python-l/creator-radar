# Short Video Monitor - Web 版环境变量模板
# 复制为 .env.local（apps/web）和 .env（apps/scraper）

# ==================== Web 应用 ====================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# 至少 32 字符；生产使用 `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-32ch
# 内测仍允许注册；个人空间默认 0 额度，加入团队后使用团队额度
REGISTER_MODE=open
DEFAULT_MONITOR_QUOTA=0
# 事务邮件；本地不测试真实投递时留空
RESEND_API_KEY=
RESEND_FROM=Iris <auth@notify.example.com>

# ==================== 数据库 ====================
# 本地经 SSH tunnel 到远程 Postgres（参见 docs/superpowers/specs/2026-05-15-postgres-migration-design.md）
# 起 tunnel：ssh -i ~/.ssh/svm_server -L 5432:127.0.0.1:5432 -fN root@<SERVER_IP>
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@localhost:5432/short_video_monitor

# ==================== 抓取服务（Python FastAPI）====================
# Web 应用调抓取服务时用
SCRAPER_BASE_URL=http://localhost:8000
# 内部服务间调用的共享密钥（任意长字符串）
SCRAPER_INTERNAL_TOKEN=

# 抓取代理（可选）
# 五档：
# - INSTAGRAM_PROXY_URL：IG 单出口（必须 sticky，IG 短时间换 IP 会触发 challenge）
# - COMMON_PROXY_POOL：TK / FB / YT 共用代理池，逗号分隔多条；平台专属池未配置时使用
# - TIKTOK_PROXY_POOL：TK 代理池，逗号分隔多条，每次抓取随机挑一条
# - FACEBOOK_PROXY_POOL：FB 代理池，逗号分隔多条；FB 跟 TK 一样池化轮换
# - YOUTUBE_PROXY_POOL：YT 代理池，逗号分隔多条；YT Shorts 无登录态，池化轮换
# - PROXY_URL：兼容旧字段，前面字段未设时所有平台都用它
# 代理串支持 http://user:pass@host:port 或裸 user:pass@host:port（自动补 http://）
PROXY_URL=
INSTAGRAM_PROXY_URL=
COMMON_PROXY_POOL=
TIKTOK_PROXY_POOL=
FACEBOOK_PROXY_POOL=
YOUTUBE_PROXY_POOL=

# Bright Data Web Scraper API（可选）：FB 匿名抓取撞登录墙时兜底。
# Facebook Reels dataset 默认 gd_lyclm3ey2q6rww027t；一般只需要填 API Key。
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_FACEBOOK_REELS_DATASET_ID=gd_lyclm3ey2q6rww027t
BRIGHT_DATA_TIKTOK_POSTS_DATASET_ID=gd_m7n5v2gq296pex2f5m
BRIGHT_DATA_INSTAGRAM_REELS_DATASET_ID=gd_l1vikfch901nx3by4
BRIGHT_DATA_YOUTUBE_VIDEOS_DATASET_ID=gd_lk56epmy2i5g7lzu0k
BRIGHT_DATA_TIMEOUT_SECONDS=120
BRIGHT_DATA_POLL_INTERVAL_SECONDS=3
BRIGHT_DATA_MAX_POLLS=20

# Instagram instagrapi 账密登录（写到 apps/scraper/.env 即可，不在 web 端用）
# ⚠️ 强烈建议用专门测试小号，不要用主号或受过警告的号
# instagrapi 会在 apps/scraper/data/ig-instagrapi.json 持久化 device + cookies
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=

# IG 抓取之间最少间隔秒数（防风控），默认 60
# INSTAGRAM_MIN_INTERVAL_SECONDS=60

# ==================== 日志 ====================
LOG_LEVEL=info
