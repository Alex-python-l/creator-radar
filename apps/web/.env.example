# 复制为 .env.local(本地)或写入 /opt/svm/.env.cvm(生产,见 docs/DEPLOY.md)。

DATABASE_URL=postgresql://localhost:5432/svm_dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── better-auth(多用户,2026-07-17) ──────────────────────────────
# secret 至少 32 字符:openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-32ch
# https 基址会自动打开 secure cookie;生产填 https://igotyoufrank.cn
BETTER_AUTH_URL=http://localhost:3000

# 注册开关:open(开放) / closed(关闭)。团队邀请使用邮件链接。
REGISTER_MODE=open
# 普通用户(role=user)可订阅的监控账号上限默认值;admin 不受限
DEFAULT_MONITOR_QUOTA=0

# Resend 事务邮件（发件域名必须已在 Resend 验证）
RESEND_API_KEY=
RESEND_FROM=Iris <auth@notify.example.com>

# ── scraper 互通(可选) ──────────────────────────────────────────
# SCRAPER_BASE_URL=http://127.0.0.1:18000
# SCRAPER_INTERNAL_TOKEN=
