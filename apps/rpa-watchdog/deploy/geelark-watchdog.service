[Unit]
Description=GeeLark RPA Heartbeat Watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/geelark-watchdog
EnvironmentFile=/opt/geelark-watchdog/.env
ExecStart=/opt/geelark-watchdog/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8002 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=75
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
