GEELARK_BASE_URL=https://openapi.geelark.cn
WATCHDOG_TIMEOUT_SECONDS=30
WATCHDOG_CHECK_INTERVAL_SECONDS=2
RPA_STARTUP_TIMEOUT_SECONDS=45
FIRST_USER_TIMEOUT_SECONDS=90
GEELARK_HTTP_TIMEOUT_SECONDS=8
RECENT_USER_CACHE_SIZE=15
RECENT_USER_HIT_THRESHOLD=3
TASK_TERMINAL_TIMEOUT_SECONDS=45
TASK_QUERY_INTERVAL_SECONDS=3
PHONE_STOP_MAX_ATTEMPTS=4
PHONE_STOP_RETRY_DELAY_SECONDS=4
GEELARK_TASK_QUERY_BODY_STYLE=ids
CLEANUP_ON_SHUTDOWN=true
SHUTDOWN_CLEANUP_TIMEOUT_SECONDS=60
ERROR_SCREENSHOT_ENABLED=true
ERROR_SCREENSHOT_DIR=rpa_error_screenshots
ERROR_SCREENSHOT_TIMEOUT_SECONDS=20
ERROR_SCREENSHOT_POLL_INTERVAL_SECONDS=1
ERROR_SCREENSHOT_DOWNLOAD_TIMEOUT_SECONDS=20
VIDEO_BLACKLIST_FILE=ignored_video_links.jsonl
