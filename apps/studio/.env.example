# Radar resolves the active personal/team workspace for every API request.
RADAR_AUTH_VERIFY_URL=http://127.0.0.1:3000/api/workspace/session

# AES-256-GCM master key for workspace credentials. Generate once with:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Back this up separately; a missing or wrong key fails startup when secrets exist.
WORKSPACE_SECRETS_KEY=

# Random 32-char token in the ?token= query string of
# /api/geelark/callback. GeeLark cannot send our session cookie, so this
# shared secret is how the receiver authenticates inbound callbacks.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Empty value disables the endpoint (returns 503).
GEELARK_CALLBACK_TOKEN=

# GEELARK_TOKEN and GEMINI_API_KEY are configured per workspace in the UI.
# These legacy values are read only by migrate_workspace_data.py during rollout.
GEELARK_TOKEN=
GEMINI_API_KEY=

# Optional dedicated HTTP proxy for Gemini caption generation. If empty,
# generate_caption.py falls back to DRIVE_IMPORT_PROXY.
GEMINI_PROXY=

# Local HTTP proxy for Drive imports (point at the overseas tunnel mouth).
# Also used by Gemini only when GEMINI_PROXY is empty.
DRIVE_IMPORT_PROXY=

# Overseas proxy-probe service (see probe/README.md). Leave empty to skip
# proxy health checks; the dashboard's dot will then stay grey.
PROBE_URL=
PROBE_TOKEN=

# Standalone GeeLark RPA progress watchdog (apps/rpa-watchdog).
# Studio forwards the current workspace's encrypted GEELARK_TOKEN server-side.
RPA_WATCHDOG_BASE_URL=http://127.0.0.1:8002
RPA_WATCHDOG_TIMEOUT_SECONDS=8

# PostgreSQL connection (Phase 1+).
# Local dev: postgresql+psycopg://<your-macos-user>@127.0.0.1:5432/mkt_dev
# Production: postgresql+psycopg://mkt:<password>@127.0.0.1:5432/mkt
DATABASE_URL=

# --- Legacy: only used by generate_caption.py CLI mode ---
# The app no longer reads these. Kept so the CLI doesn't KeyError if invoked.
# Remove once generate_caption.py CLI mode is deleted (separate cleanup PR).
SERVICE_ACCOUNT_PATH=service_account.json
DRIVE_FOLDER_ID=

# Bright Data — TikTok keyword discovery (for CommentModal "Discover" tab).
# Token comes from Bright Data dashboard → Account settings → API tokens.
# Dataset ID rarely changes; override only if Bright Data renames it.
BRIGHTDATA_TOKEN=
BRIGHTDATA_KEYWORD_DATASET_ID=gd_lilwhto81z415d9mdl
